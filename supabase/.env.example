# Secrets for the receipt-reading function. Keep the real values out of git.
#
#   1. Copy this file to supabase/.env  (that file is gitignored)
#   2. Fill in the values below
#   3. Send them to Supabase:  supabase secrets set --env-file supabase/.env
#
# Never put these in js/config.js. Everything in that file is public on GitHub Pages.

# Anthropic API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the receipt-reading model (defaults to claude-haiku-5-5)
# RECEIPT_MODEL=
